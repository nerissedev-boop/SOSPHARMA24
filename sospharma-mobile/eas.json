{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_API_MOCK": "1", "EXPO_PUBLIC_ENVIRONNEMENT": "development" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_ENVIRONNEMENT": "preview" }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_MOCK": "0", "EXPO_PUBLIC_ENVIRONNEMENT": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
