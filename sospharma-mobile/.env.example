# Copiez ce fichier en .env (non versionné) et adaptez les valeurs.
# Les variables EXPO_PUBLIC_* sont intégrées au bundle : n'y mettez jamais de secret.

# API Laravel (sans /api/v1 à la fin).
EXPO_PUBLIC_API_URL=https://api.example.invalid

# Adaptateur de démonstration (données FICTIVES d'Abidjan) : 1 = actif (défaut), 0 = API réelle.
EXPO_PUBLIC_API_MOCK=1

# Position simulée en mode démo (« lat,lng », Cocody). Vide = vraie position GPS.
EXPO_PUBLIC_POSITION_SIMULEE=5.3600,-3.9800

# Sentry : laissé vide, le suivi des erreurs est désactivé.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENVIRONNEMENT=development

# Carte MapLibre (voir README, section Carte). Tout vide = style local minimal de repli.
# Style complet hébergé (jour, et nuit facultatif) :
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_MAP_STYLE_URL_NUIT=
# Ou tuiles vectorielles au schéma OpenMapTiles ({z}/{x}/{y}.pbf) + glyphes pour les noms :
# Sans clé, pour le développement : OpenFreeMap (gratuit, données OpenStreetMap), fichier TileJSON :
#   EXPO_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/planet
#   EXPO_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
EXPO_PUBLIC_MAP_TILES_URL=
EXPO_PUBLIC_MAP_GLYPHS_URL=

# Base des liens de partage d'une fiche (ex. https://sospharma24.ci). Vide = lien Google Maps.
EXPO_PUBLIC_LIEN_PARTAGE_BASE=

# Build EAS (envoi des sources maps à Sentry) : SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN
# se règlent dans les variables d'environnement EAS, pas ici.
